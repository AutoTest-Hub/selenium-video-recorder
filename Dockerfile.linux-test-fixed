# Dockerfile for testing Linux video recording optimizations (ARM64 compatible)
FROM ubuntu:22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-aarch64
ENV PATH="/opt/maven/bin:${PATH}"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Basic tools
    curl \
    wget \
    unzip \
    xvfb \
    gnupg \
    software-properties-common \
    # Java 11
    openjdk-11-jdk \
    # Chrome dependencies
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxss1 \
    libxtst6 \
    xdg-utils \
    # FFmpeg for video processing
    ffmpeg \
    # Clean up
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Chromium (works on ARM64)
RUN apt-get update && apt-get install -y chromium-browser \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/chromium-browser /usr/bin/google-chrome \
    && ln -sf /usr/bin/chromium-browser /usr/bin/chrome

# Install Maven
RUN curl -fsSL https://archive.apache.org/dist/maven/maven-3/3.9.4/binaries/apache-maven-3.9.4-bin.tar.gz | tar xzf - -C /opt \
    && mv /opt/apache-maven-3.9.4 /opt/maven

# Create user for running tests
RUN useradd -m -s /bin/bash testuser \
    && mkdir -p /home/testuser/.cache/google-chrome \
    && chown -R testuser:testuser /home/testuser

# Create workspace directory
WORKDIR /workspace
RUN chown testuser:testuser /workspace

# Switch to test user
USER testuser

# Copy project files
COPY --chown=testuser:testuser . /workspace/

# Create test script
RUN echo '#!/bin/bash' > /workspace/run_tests.sh && \
    echo 'set -e' >> /workspace/run_tests.sh && \
    echo '' >> /workspace/run_tests.sh && \
    echo '# Set environment variables' >> /workspace/run_tests.sh && \
    echo 'export JAVA_HOME=/usr/lib/jvm/java-11-openjdk-aarch64' >> /workspace/run_tests.sh && \
    echo 'export PATH="/opt/maven/bin:$PATH"' >> /workspace/run_tests.sh && \
    echo 'export DISPLAY=:99' >> /workspace/run_tests.sh && \
    echo '' >> /workspace/run_tests.sh && \
    echo 'echo "🐧 Linux Video Recording Optimization Tests (Docker Container)"' >> /workspace/run_tests.sh && \
    echo 'echo "============================================================"' >> /workspace/run_tests.sh && \
    echo '' >> /workspace/run_tests.sh && \
    echo '# Start Xvfb for headless GUI' >> /workspace/run_tests.sh && \
    echo 'Xvfb :99 -screen 0 1280x720x24 > /dev/null 2>&1 &' >> /workspace/run_tests.sh && \
    echo 'sleep 3' >> /workspace/run_tests.sh && \
    echo '' >> /workspace/run_tests.sh && \
    echo 'echo "Environment:"' >> /workspace/run_tests.sh && \
    echo 'echo "  OS: $(uname -a)"' >> /workspace/run_tests.sh && \
    echo 'echo "  Java Home: $JAVA_HOME"' >> /workspace/run_tests.sh && \
    echo 'echo "  Java: $(java -version 2>&1 | head -n1 || echo \"Java not working\")"' >> /workspace/run_tests.sh && \
    echo 'echo "  Chrome: $(chromium-browser --version 2>/dev/null || echo \"Chrome not working\")"' >> /workspace/run_tests.sh && \
    echo 'echo "  Maven: $(mvn -version 2>/dev/null | head -n1 || echo \"Maven not working\")"' >> /workspace/run_tests.sh && \
    echo 'echo "  FFmpeg: $(ffmpeg -version 2>/dev/null | head -n1 || echo \"FFmpeg not working\")"' >> /workspace/run_tests.sh && \
    echo 'echo "  Display: $DISPLAY"' >> /workspace/run_tests.sh && \
    echo 'echo ""' >> /workspace/run_tests.sh && \
    echo '' >> /workspace/run_tests.sh && \
    echo '# Test basic functionality' >> /workspace/run_tests.sh && \
    echo 'echo "🧪 Testing Linux optimization components..."' >> /workspace/run_tests.sh && \
    echo 'java -cp "target/classes:$(mvn dependency:build-classpath -q -Dmdep.outputFile=/dev/stdout 2>/dev/null)" com.example.automation.demo.LinuxOptimizationDemo environmentDetection || echo "Demo test failed"' >> /workspace/run_tests.sh && \
    echo '' >> /workspace/run_tests.sh && \
    echo '# Compile project' >> /workspace/run_tests.sh && \
    echo 'echo "🔨 Compiling project..."' >> /workspace/run_tests.sh && \
    echo 'mvn clean compile test-compile -q' >> /workspace/run_tests.sh && \
    echo '' >> /workspace/run_tests.sh && \
    echo '# Run Linux optimization tests' >> /workspace/run_tests.sh && \
    echo 'echo "🚀 Running Linux optimization tests..."' >> /workspace/run_tests.sh && \
    echo 'mvn test -Dtest=LinuxOptimizationTest -Dheadless=true || echo "Full tests failed, trying simulation tests..."' >> /workspace/run_tests.sh && \
    echo 'mvn test -Dtest=LinuxSimulationTest -Dheadless=true || echo "Simulation tests also failed"' >> /workspace/run_tests.sh && \
    echo '' >> /workspace/run_tests.sh && \
    echo 'echo ""' >> /workspace/run_tests.sh && \
    echo 'echo "✅ Linux optimization tests completed in Docker container!"' >> /workspace/run_tests.sh && \
    chmod +x /workspace/run_tests.sh

# Default command
CMD ["/workspace/run_tests.sh"]