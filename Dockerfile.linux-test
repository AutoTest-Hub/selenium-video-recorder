# Dockerfile for testing Linux video recording optimizations
# This provides a Linux environment to validate the Linux-specific fixes

FROM ubuntu:22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99
ENV CHROME_BIN=/usr/bin/google-chrome
ENV PATH="/opt/maven/bin:${PATH}"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Basic tools
    curl \
    wget \
    unzip \
    xvfb \
    gnupg \
    software-properties-common \
    # Java 11
    openjdk-11-jdk \
    # Chrome dependencies
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxss1 \
    libxtst6 \
    xdg-utils \
    # FFmpeg for video processing
    ffmpeg \
    # Process management
    supervisor \
    # Clean up
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Chromium (works on ARM64)
RUN apt-get update && apt-get install -y chromium-browser \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/chromium-browser /usr/bin/google-chrome \
    && ln -sf /usr/bin/chromium-browser /usr/bin/chrome

# Install Maven
RUN curl -fsSL https://archive.apache.org/dist/maven/maven-3/3.9.4/binaries/apache-maven-3.9.4-bin.tar.gz | tar xzf - -C /opt \
    && mv /opt/apache-maven-3.9.4 /opt/maven

# Set JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64

# Create user for running tests (security best practice)
RUN useradd -m -s /bin/bash testuser \
    && mkdir -p /home/testuser/.cache/google-chrome \
    && chown -R testuser:testuser /home/testuser

# Create workspace directory
WORKDIR /workspace
RUN chown testuser:testuser /workspace

# Switch to test user
USER testuser

# Copy project files
COPY --chown=testuser:testuser . /workspace/

# Create script to run tests in container
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "🐧 Linux Video Recording Optimization Tests (Docker Container)"\n\
echo "============================================================"\n\
\n\
# Start Xvfb for headless GUI\n\
Xvfb :99 -screen 0 1280x720x24 &\n\
export DISPLAY=:99\n\
\n\
# Wait for Xvfb to start\n\
sleep 2\n\
\n\
echo "Environment:"\n\
echo "  OS: $(uname -a)"\n\
echo "  Java: $(java -version 2>&1 | head -n1)"\n\
echo "  Chrome: $(google-chrome --version)"\n\
echo "  Maven: $(mvn -version | head -n1)"\n\
echo "  FFmpeg: $(ffmpeg -version | head -n1)"\n\
echo "  Display: $DISPLAY"\n\
echo ""\n\
\n\
# Clean and compile\n\
echo "Compiling project..."\n\
mvn clean compile test-compile -q\n\
\n\
# Run Linux optimization tests\n\
echo "Running Linux optimization tests..."\n\
mvn test -Dtest.suite=testng-linux-only.xml -Dheadless=true\n\
\n\
echo ""\n\
echo "✅ Linux optimization tests completed in Docker container!"\n\
' > /workspace/run_docker_tests.sh \
    && chmod +x /workspace/run_docker_tests.sh

# Expose any ports if needed (for debugging)
EXPOSE 9222

# Default command
CMD ["/workspace/run_docker_tests.sh"]